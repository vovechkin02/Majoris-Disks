<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="com.majoris.disks.btrfs-replacement-status">
    <description>Inspect Btrfs maintenance status and eligibility</description>
    <message>Check Btrfs replacement or balance status and eligibility</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/majoris-disks-btrfs-status</annotate>
  </action>
  <action id="com.majoris.disks.btrfs-default">
    <description>Verify and manage Btrfs storage</description>
    <message>Authentication is required to verify or modify Btrfs storage</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/majoris-disks-btrfs-default</annotate>
  </action>
</policyconfig>
