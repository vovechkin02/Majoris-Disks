<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="com.majoris.disks.lvm-cache-inspect">
    <description>Inspect LVM cache status</description>
    <message>Authentication is required to read LVM cache health and pending writes</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/majoris-disks-lvm-cache-inspector</annotate>
  </action>
</policyconfig>
