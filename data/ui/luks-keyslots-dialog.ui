<interface>
  <template class="MajorisDisksLuksKeyslotsDialog" parent="AdwAlertDialog">
    <property name="heading">Manage Unlocking Credentials</property>
    <property name="extra-child">
      <object class="GtkScrolledWindow">
        <property name="max-content-height">320</property>
        <property name="propagate-natural-height">true</property>
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="AdwPreferencesGroup" id="slot_group">
            <property name="title">Keyslots</property>
            <child>
              <object class="GtkListBox" id="slot_list">
                <property name="selection-mode">single</property>
                <style><class name="boxed-list"/></style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
    <responses>
      <response id="close">Close</response>
      <response id="review-config">Review Automatic Unlocking…</response>
      <response id="identify">Verify Credential…</response>
      <response id="add">Add Credential…</response>
      <response id="change">Change…</response>
      <response id="remove">Remove…</response>
    </responses>
    <property name="default-response">close</property>
    <property name="close-response">close</property>
  </template>
</interface>
