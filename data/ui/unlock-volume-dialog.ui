<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MajorisDisksUnlockVolumeDialog" parent="AdwAlertDialog">
    <property name="heading">Unlock Encrypted Volume</property>
    <property name="extra-child">
      <object class="AdwPreferencesGroup">
        <child><object class="AdwPasswordEntryRow" id="secret"><property name="title">Passphrase</property><property name="show-apply-button">false</property></object></child>
        <child><object class="AdwSwitchRow" id="use_keyfile"><property name="title">Use a single keyfile</property><property name="subtitle">The keyfile is used in place of a passphrase</property><property name="visible">false</property></object></child>
        <child><object class="AdwSwitchRow" id="read_only_row"><property name="title">Unlock read-only</property></object></child>
        <child><object class="AdwActionRow" id="keyfile_row"><property name="title">Keyfile</property><property name="subtitle">None selected</property><property name="visible">false</property><child type="suffix"><object class="GtkButton" id="choose_keyfile"><property name="label">Choose…</property><property name="valign">center</property></object></child></object></child>
      </object>
    </property>
    <responses>
      <response id="cancel">Cancel</response>
      <response id="unlock" appearance="suggested">Unlock</response>
    </responses>
    <property name="default-response">unlock</property>
    <property name="close-response">cancel</property>
  </template>
</interface>
