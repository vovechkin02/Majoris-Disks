<interface>
  <template class="MajorisDisksFormatDiskDialog" parent="AdwAlertDialog">
    <property name="extra-child"><object class="AdwPreferencesGroup">
      <child><object class="AdwSwitchRow" id="overwrite_row"><property name="title">Overwrite accessible logical blocks with zeros</property><property name="subtitle">Runs before creating the partition table. Remapped sectors, reserved space and inaccessible SSD flash may retain data.</property><property name="subtitle-lines">4</property></object></child>
    </object></property>
    <responses>
      <response id="cancel">Cancel</response>
      <response id="gpt" appearance="destructive">Create GPT</response>
      <response id="dos" appearance="destructive">Create MBR</response>
      <response id="empty" appearance="destructive">Make Empty</response>
    </responses>
    <property name="default-response">cancel</property>
    <property name="close-response">cancel</property>
  </template>
</interface>
