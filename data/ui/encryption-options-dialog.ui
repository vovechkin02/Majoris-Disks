<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MajorisDisksEncryptionOptionsDialog" parent="AdwAlertDialog">
    <property name="heading">Encryption Options</property>
    <property name="extra-child">
      <object class="AdwPreferencesGroup">
        <child><object class="AdwSwitchRow" id="custom"><property name="title">Use persistent unlocking configuration</property></object></child>
        <child><object class="AdwSwitchRow" id="startup"><property name="title">Unlock at system startup</property></object></child>
        <child><object class="AdwEntryRow" id="mapping_name"><property name="title">Clear-text mapping name</property></object></child>
        <child><object class="AdwEntryRow" id="options"><property name="title">crypttab options</property></object></child>
        <child><object class="AdwPasswordEntryRow" id="secret"><property name="title">New stored passphrase (optional)</property></object></child>
        <child><object class="AdwActionRow" id="keyfile"><property name="title">Protected key file</property></object></child>
        <child><object class="AdwActionRow" id="identifier"><property name="title">Stable device identifier</property></object></child>
      </object>
    </property>
    <responses>
      <response id="cancel">Cancel</response>
      <response id="apply" appearance="suggested">Apply</response>
    </responses>
    <property name="default-response">cancel</property>
    <property name="close-response">cancel</property>
  </template>
</interface>
