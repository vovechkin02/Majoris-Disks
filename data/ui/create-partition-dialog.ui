<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MajorisDisksCreatePartitionDialog" parent="AdwAlertDialog">
    <property name="heading">Create Partition</property>
    <property name="extra-child"><object class="AdwPreferencesGroup">
      <child><object class="AdwActionRow" id="available_row"><property name="title">Available space</property></object></child>
      <child><object class="AdwSpinRow" id="size_row"><property name="title">Partition size (MiB)</property><property name="digits">0</property><property name="adjustment"><object class="GtkAdjustment"><property name="lower">1</property><property name="upper">1</property><property name="step-increment">1</property><property name="page-increment">128</property></object></property></object></child>
      <child><object class="AdwActionRow" id="remaining_row"><property name="title">Space remaining</property></object></child>
      <child><object class="AdwComboRow" id="kind_row"><property name="title">Partition kind</property></object></child>
      <child><object class="AdwEntryRow" id="type_row"><property name="title">Partition type</property></object></child>
      <child><object class="AdwEntryRow" id="name_row"><property name="title">GPT partition name</property></object></child>
      <child><object class="AdwComboRow" id="filesystem_row"><property name="title">Filesystem</property></object></child>
      <child><object class="AdwEntryRow" id="label_row"><property name="title">Volume label</property></object></child>
    </object></property>
    <responses><response id="cancel">Cancel</response><response id="create" appearance="suggested">Create</response></responses>
    <property name="default-response">cancel</property><property name="close-response">cancel</property>
  </template>
</interface>
