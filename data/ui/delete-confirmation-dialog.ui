<interface>
  <template class="MajorisDisksDeleteConfirmationDialog" parent="AdwAlertDialog">
    <responses>
      <response id="cancel">Cancel</response>
      <response id="delete" appearance="destructive">Delete Partition</response>
    </responses>
    <property name="default-response">cancel</property>
    <property name="close-response">cancel</property>
  </template>
</interface>
