<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MajorisDisksDriveView" parent="GtkBox">
<property name="orientation">vertical</property>
<child><object class="GtkScrolledWindow"><property name="vexpand">true</property><property name="hscrollbar-policy">never</property><property name="child">
<object class="GtkBox"><property name="orientation">vertical</property>

<child><object class="AdwPreferencesGroup"><child><object class="AdwActionRow" id="summary"><property name="use-markup">false</property>
<child type="prefix"><object class="GtkImage" id="drive_icon"/></child>
<child type="suffix"><object class="GtkButton" id="initialize_disk"><property name="label">Initialize Disk</property><property name="valign">center</property></object></child>
<child type="suffix"><object class="GtkButton" id="benchmark_button"><property name="label">Benchmark</property><property name="valign">center</property></object></child>
<child type="suffix"><object class="GtkButton" id="health"><property name="label">Health</property><property name="valign">center</property><property name="visible">false</property></object></child>
<child type="suffix"><object class="GtkMenuButton" id="drive_actions"><property name="label">Drive Actions</property><property name="valign">center</property><property name="popover"><object class="GtkPopover"><property name="child"><object class="GtkBox"><property name="orientation">vertical</property>
  <child><object class="GtkButton" id="detach_image_button"><property name="label">Detach Disk Image</property></object></child>
  <child><object class="GtkButton" id="backup_drive"><property name="label">Create Disk Image</property></object></child>
  <child><object class="GtkButton" id="restore_drive"><property name="label">Restore Disk Image</property></object></child>
  <child><object class="GtkButton" id="eject_drive"><property name="label">Eject</property></object></child>
  <child><object class="GtkButton" id="power_off_drive"><property name="label">Safe Power Off</property></object></child>
  <child><object class="GtkButton" id="standby_drive"><property name="label">Standby</property></object></child>
  <child><object class="GtkButton" id="wake_drive"><property name="label">Wake</property></object></child>
  <child><object class="GtkButton" id="drive_settings"><property name="label">Drive Settings</property></object></child>
</object></property></object></property></object></child>
<child type="suffix"><object class="GtkButton" id="information"><property name="label">Information</property><property name="valign">center</property></object></child></object></child></object></child>
<child><object class="MajorisDisksPartitionMap" id="map"/></child>
<child><object class="GtkListBox" id="volumes"><style><class name="boxed-list"/></style></object></child>
<child><object class="AdwPreferencesGroup" id="properties"><property name="title">Volume information</property>

<child><object class="GtkLabel" id="usage"><property name="xalign">0</property><property name="wrap">true</property></object></child>
<child><object class="GtkBox">
<child><object class="GtkButton" id="operation"><property name="label">Mount</property></object></child>
<child><object class="GtkButton" id="check_filesystem"><property name="label">Check Filesystem</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="repair_filesystem"><property name="label">Repair Filesystem</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="take_ownership"><property name="label">Take Ownership</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="create_lvm"><property name="label">Create Logical Volume</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="add_lvm_member"><property name="label">Add Physical Volume…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="manage_lvm"><property name="label">Manage Logical Volumes</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="rename_lvm"><property name="label">Rename Logical Volume</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="raid_recover"><property name="label">Start Degraded RAID…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="raid_power"><property name="label">Start RAID Array</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="raid_delete"><property name="label">Delete Stopped RAID Array…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="raid_replace"><property name="label">Replace Missing RAID Member…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="raid_add"><property name="label">Add RAID Spare…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="raid_remove_spare"><property name="label">Remove Inactive RAID Member…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="raid_check"><property name="label">Check RAID Consistency</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="btrfs_balance"><property name="label">Btrfs Maintenance…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="btrfs_allocation"><property name="label">Btrfs Allocation…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="btrfs_remove"><property name="label">Remove Btrfs Device…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="btrfs_add"><property name="label">Add Btrfs Device…</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="btrfs_subvolumes"><property name="label">List Btrfs Subvolumes</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="edit_label"><property name="label">Edit Label</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="mount_options"><property name="label">Mount Options</property><property name="visible">false</property></object></child>
<child>
  <object class="GtkMenuButton" id="encryption_menu">
    <property name="label">Encryption</property>
    <property name="visible">false</property>
    <property name="popover">
      <object class="GtkPopover">
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child><object class="GtkButton" id="unlock_volume"><property name="label">Unlock</property><property name="visible">false</property></object></child>
            <child><object class="GtkButton" id="lock_volume"><property name="label">Lock</property><property name="visible">false</property></object></child>
            <child><object class="GtkButton" id="change_passphrase"><property name="label">Change Passphrase…</property></object></child>
            <child><object class="GtkButton" id="encryption_options"><property name="label">Automatic Unlocking Options…</property></object></child>
            <child><object class="GtkButton" id="luks_keyslots"><property name="label">Manage Unlocking Credentials…</property></object></child>
            <child><object class="GtkButton" id="luks_backup"><property name="label">Back Up LUKS Header…</property></object></child>
            <child><object class="GtkButton" id="luks_restore"><property name="label">Restore LUKS Header…</property></object></child>
            <child><object class="GtkButton" id="resize_encrypted"><property name="label">Resize Encrypted Volume…</property><property name="visible">false</property></object></child>
            <child><object class="GtkButton" id="luks_recovery"><property name="label">Advanced Damaged-Header Recovery…</property></object></child>
          </object>
        </child>
      </object>
    </property>
  </object>
</child>
<child><object class="GtkButton" id="format_volume"><property name="label">Format Volume</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="edit_partition"><property name="label">Edit Partition</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="create_partition"><property name="label">Create Partition</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="resize_volume"><property name="label">Resize Volume</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="delete_partition"><property name="label">Delete Partition</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="backup_volume"><property name="label">Create Volume Image</property></object></child>
<child><object class="GtkButton" id="restore_partition"><property name="label">Restore Partition Image</property><property name="visible">false</property></object></child>
<child><object class="GtkButton" id="open_files"><property name="label">Open in Files</property></object></child>
</object></child></object></child>
</object></property></object></child>
  </template>
</interface>
