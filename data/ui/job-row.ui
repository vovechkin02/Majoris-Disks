  <child type="suffix"><object class="GtkProgressBar" id="progress"><property name="valign">center</property><property name="width-request">120</property></object></child>
  <child type="suffix"><object class="GtkButton" id="cancel"><property name="label">Cancel</property><property name="valign">center</property></object></child>
</template></interface>
