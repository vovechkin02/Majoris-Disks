<interface>
  <template class="MajorisDisksBtrfsSubvolumesDialog" parent="AdwAlertDialog">
    <property name="heading">Btrfs Subvolumes</property>
    <property name="extra-child">
      <object class="AdwPreferencesGroup">
        <child><object class="AdwComboRow" id="subvolumes"><property name="title">Subvolume</property></object></child>
        <child><object class="AdwActionRow" id="subvolume_access"><property name="title">Subvolume Access</property></object></child>
        <child><object class="AdwActionRow" id="quota_summary"><property name="title">Subvolume Quota</property></object></child>
        <child><object class="AdwEntryRow" id="new_subvolume"><property name="title">New top-level name</property></object></child>
        <child><object class="AdwSwitchRow" id="snapshot_read_only"><property name="title">Read-only snapshot</property><property name="active">true</property></object></child>
        <child><object class="AdwSwitchRow" id="configure_quota"><property name="title">Review Quota Settings After Creation</property><property name="visible">false</property></object></child>
      </object>
    </property>
    <responses>
      <response id="close">Close</response>
      <response id="quota">Quota Settings…</response>
      <response id="apply" appearance="suggested">Set Default</response>
      <response id="create">Create Subvolume</response>
      <response id="snapshot">Snapshot Selected</response>
      <response id="delete" appearance="destructive">Delete Selected…</response>
    </responses>
    <property name="default-response">close</property>
    <property name="close-response">close</property>
  </template>
</interface>
