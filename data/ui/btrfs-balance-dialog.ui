<interface>
  <template class="MajorisDisksBtrfsBalanceDialog" parent="AdwAlertDialog">
    <property name="heading">Btrfs Maintenance</property>
    <property name="body">Choose a usage limit for a filtered balance, or review a profile conversion.</property>
    <property name="extra-child">
      <object class="AdwActionRow">
        <property name="title">Maximum chunk usage (%)</property>
        <child type="suffix"><object class="GtkSpinButton" id="usage"><property name="numeric">true</property>
          <property name="adjustment"><object class="GtkAdjustment"><property name="lower">0</property><property name="upper">100</property><property name="value">20</property><property name="step-increment">1</property></object></property>
        </object></child>
      </object>
    </property>
    <responses>
      <response id="close">Close</response>
      <response id="convert">Convert Allocation Profiles…</response>
      <response id="balance-status">Balance Status</response>
      <response id="scrub">Manage Scrub…</response>
      <response id="balance-data">Balance Data</response>
      <response id="balance-metadata">Balance Metadata</response>
      <response id="balance-pause">Pause</response>
      <response id="balance-resume">Resume</response>
      <response id="balance-cancel" appearance="destructive">Cancel Balance</response>
    </responses>
    <property name="default-response">close</property>
    <property name="close-response">close</property>
  </template>
</interface>
