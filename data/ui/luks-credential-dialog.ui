<interface>
  <template class="MajorisDisksLuksCredentialDialog" parent="AdwAlertDialog">
    <property name="extra-child">
      <object class="AdwPreferencesGroup">
        <child>
          <object class="AdwComboRow" id="remaining_slot">
            <property name="title">Keyslot to keep</property>
          </object>
        </child>
        <child>
          <object class="AdwPasswordEntryRow" id="current">
            <property name="title">Current passphrase</property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title">Current keyfile</property>
            <child type="suffix">
              <object class="GtkButton" id="current_file_button">
                <property name="label">Choose…</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPasswordEntryRow" id="other">
            <property name="title">New passphrase</property>
          </object>
        </child>
        <child>
          <object class="AdwPasswordEntryRow" id="confirmation">
            <property name="title">Confirm new passphrase</property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="other_file_row">
            <property name="title">New keyfile</property>
            <child type="suffix">
              <object class="GtkButton" id="other_file_button">
                <property name="label">Choose…</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <responses>
      <response id="cancel">Cancel</response>
      <response id="apply" appearance="suggested">Apply</response>
    </responses>
    <property name="default-response">cancel</property>
    <property name="close-response">cancel</property>
  </template>
</interface>
