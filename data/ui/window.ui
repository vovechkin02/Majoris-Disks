<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <menu id="application_menu">
    <item><attribute name="label">Create LVM Volume Group…</attribute><attribute name="action">win.create-vg</attribute></item>
    <item><attribute name="label">Create RAID Array…</attribute><attribute name="action">win.create-raid</attribute></item>
    <item><attribute name="label">Inspect or Convert Image…</attribute><attribute name="action">app.virtual-image</attribute></item>
    <item><attribute name="label">Attach Disk Image…</attribute><attribute name="action">app.attach-image</attribute></item>
    <item><attribute name="label">Create Blank Disk Image…</attribute><attribute name="action">app.blank-image</attribute></item>
    <item><attribute name="label">Preferences</attribute><attribute name="action">app.preferences</attribute></item>
    <item><attribute name="label">About Disks</attribute><attribute name="action">app.about</attribute></item>
    <item><attribute name="label">Quit</attribute><attribute name="action">app.quit</attribute></item>
  </menu>
  <template class="MajorisDisksDisksWindow" parent="AdwApplicationWindow">
<property name="title">Disks</property>
<property name="default-width">900</property><property name="default-height">650</property>
<property name="content"><object class="AdwNavigationSplitView" id="split">
<property name="sidebar"><object class="AdwNavigationPage"><property name="title">Devices</property><property name="child">
<object class="AdwToolbarView"><child type="top"><object class="AdwHeaderBar"><child type="start"><object class="GtkMenuButton"><property name="icon-name">open-menu-symbolic</property><property name="menu-model">application_menu</property></object></child><child type="end"><object class="GtkButton" id="refresh_button"><property name="label">Refresh</property></object></child></object></child>
<property name="content"><object class="GtkScrolledWindow"><property name="child"><object class="GtkBox"><property name="orientation">vertical</property><child><object class="GtkListBox" id="sidebar"><style><class name="navigation-sidebar"/></style></object></child>
<child><object class="GtkListBox" id="advanced_sidebar"><style><class name="navigation-sidebar"/></style></object></child>
</object></property></object></property>
</object></property></object></property>
<property name="content"><object class="AdwNavigationPage"><property name="title">Storage</property><property name="child">
<object class="AdwToolbarView"><child type="top"><object class="AdwHeaderBar">
<child type="end"><object class="GtkMenuButton" id="jobs_button"><property name="label">Jobs</property><property name="visible">false</property></object></child>
</object></child><property name="content">
<object class="AdwToastOverlay" id="notifications"><property name="child"><object class="GtkStack" id="states">
<child><object class="AdwStatusPage" id="status"><property name="title">Connecting to UDisks…</property><property name="icon-name">drive-harddisk-symbolic</property></object></child>
<child><object class="MajorisDisksDriveView" id="drive_view"/></child>
<child><object class="GtkScrolledWindow" id="advanced_view">
<property name="hscrollbar-policy">never</property><property name="child">
<object class="AdwClamp"><property name="child">
<object class="AdwPreferencesPage">
<child><object class="AdwPreferencesGroup" id="advanced_summary">
<child><object class="AdwActionRow" id="advanced_details"><property name="use-markup">false</property></object></child>
<child><object class="AdwActionRow" id="advanced_jobs"><property name="title">Active Jobs</property><property name="use-markup">false</property></object></child>
</object></child>
<child><object class="AdwPreferencesGroup"><property name="title">Management</property>
<child><object class="AdwActionRow" id="advanced_manage"><property name="activatable">True</property></object></child>
<child><object class="AdwActionRow" id="advanced_maintenance"><property name="activatable">True</property></object></child>
<child><object class="AdwActionRow" id="advanced_recovery"><property name="activatable">True</property></object></child>
<child><object class="AdwActionRow" id="advanced_mdraid"><property name="title">Manage RAID Array</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_btrfs_replace"><property name="title">Replace Btrfs Device…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_btrfs_quota"><property name="title">Manage Btrfs Quotas…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_lvm_rename"><property name="title">Rename Volume Group…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_lvm_refresh"><property name="title">Refresh and Reassess</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_lvm_repair"><property name="title">Repair LVM RAID 1…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_lvm_cleanup"><property name="title">Remove Missing Physical-Volume Records…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_lvm_cache"><property name="title">Attach Cache…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_lvm_uncache"><property name="title">Split or Remove Cache…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_lvm_cache_status"><property name="title">Inspect Cache Status…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
<child><object class="AdwActionRow" id="advanced_lvm_layout"><property name="title">Create Logical Volume with Physical Placement…</property><property name="activatable">True</property><property name="visible">False</property></object></child>
</object></child>
<child><object class="AdwPreferencesGroup" id="advanced_members"><property name="title">Members and Volumes</property></object></child>
</object></property></object></property>
</object></child>
</object></property></object></property></object>
</property></object></property></object></property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 600px</condition>
        <setter object="split" property="collapsed">True</setter>
      </object>
    </child>
  </template>
</interface>
