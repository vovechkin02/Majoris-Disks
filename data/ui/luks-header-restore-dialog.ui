<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MajorisDisksLuksHeaderRestoreDialog" parent="AdwAlertDialog">
    <property name="heading">Restore LUKS Header?</property>
    <property name="body">This replaces the target’s header and keyslots. The backup contains historical keyslots. Only credentials in the restored header may work afterward. Restoring to the wrong target can permanently prevent access to its data.</property>
    <property name="extra-child">
      <object class="AdwPreferencesGroup">
        <child>
          <object class="AdwEntryRow" id="confirmation">
            <property name="title">Type the target device path to confirm</property>
          </object>
        </child>
      </object>
    </property>
    <responses>
      <response id="cancel">Cancel</response>
      <response id="restore" appearance="destructive">Restore Header</response>
    </responses>
    <property name="default-response">cancel</property>
    <property name="close-response">cancel</property>
  </template>
</interface>
